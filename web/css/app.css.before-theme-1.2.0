umn;gap:7px}.file.selected{border-color:var(--accent);box-shadow:0 0 0 1px var(--accent)}.file-icon{font-size:30px}.file-name{font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.file-meta{font-size:11px;color:var(--muted);display:flex;justify-content:space-between}.cards{display:grid;gap:10px}.card{background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:14px}.section-head{justify-content:space-between}.editor-meta{display:flex;justify-content:space-between;color:var(--muted);font-size:12px;margin-bottom:6px}.editor-toolbar{flex-wrap:wrap}.editor-toolbar button{font-size:13px}.editor{width:100%}#editor{width:100%;height:calc(100vh - 190px);resize:none;background:#080b10;color:#e5e7eb;border:1px solid var(--line);border-radius:10px;padding:14px;font:13px ui-monospace,SFMono-Regular,Consolas,monospace;direction:ltr;text-align:left;tab-size:2}.tool-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:12px}.tool{background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:14px}.tool h3{margin-top:0}.tool textarea{height:150px;resize:vertical}.tool button{margin:6px 4px 0 0}.tool pre{background:#080b10;border:1px solid var(--line);padding:10px;min-height:30px;overflow:auto;white-space:pre-wrap}.console{background:#05070a;border:1px solid var(--line);border-radius:10px;height:calc(100vh - 190px);padding:12px;overflow:auto;font:13px ui-monospace,monospace;direction:ltr;text-align:left;white-space:pre-wrap}.console-input{background:#05070a;border:1px solid var(--line);padding:8px;border-radius:10px}.console-input input{border:0;outline:0;background:transparent;color:#fff;direction:ltr}.modal{position:fixed;inset:0;background:#0009;z-index:20;display:grid;place-items:center;padding:18px}.modal-card{background:var(--panel);border:1px solid var(--line);border-radius:14px;max-width:600px;width:100%;max-height:85vh;overflow:auto;padding:16px}.modal-head{display:flex;justify-content:space-between;align-items:center}.modal-head h3{margin:0 0 14px}.modal-actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}.danger{color:#fff;background:var(--danger)}@media(max-width:800px){.sidebar{width:180px}.content{margin-right:0;padding-bottom:72px}.sidebar{transform:translateX(100%)}.sidebar.open{transform:translateX(0)}.file-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.topbar{position:sticky}.tool-grid{grid-template-columns:1fr}}

/* =========================================================
   QUICK FILE STUDIO - LARGE FILE MANAGER UI
   ========================================================= */

:root {
  --qfs-bg: #080a0f;
  --qfs-panel: #10131b;
  --qfs-panel2: #151925;
  --qfs-border: rgba(255,255,255,.08);
  --qfs-text: #f4f6fb;
  --qfs-muted: #8f98aa;
  --qfs-accent: #7c5cff;
  --qfs-accent2: #5b8cff;
  --qfs-radius: 18px;
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  min-height: 100vh;
  background:
    radial-gradient(
      circle at 20% 0%,
      rgba(124,92,255,.13),
      transparent 35%
    ),
    var(--qfs-bg);

  color: var(--qfs-text);
  font-family:
    system-ui,
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    sans-serif;
}

button,
input,
textarea,
select {
  font: inherit;
}

button {
  min-height: 46px;
  border-radius: 13px;
  border: 1px solid var(--qfs-border);
  background: var(--qfs-panel2);
  color: var(--qfs-text);
  cursor: pointer;
}

button:active {
  transform: scale(.98);
}

.app {
  width: 100%;
  min-height: 100vh;
}

.topbar {
  min-height: 72px;
  padding: 12px 18px;

  display: flex;
  align-items: center;
  gap: 14px;

  background: rgba(8,10,15,.94);
  border-bottom: 1px solid var(--qfs-border);

  position: sticky;
  top: 0;
  z-index: 50;

  backdrop-filter: blur(18px);
}

.brand {
  font-size: 22px;
  font-weight: 800;
  letter-spacing: -.5px;
}

.brand-subtitle {
  color: var(--qfs-muted);
  font-size: 12px;
}

.top-search {
  flex: 1;
  max-width: 720px;
}

.top-search input {
  width: 100%;
  min-height: 48px;
  padding: 0 18px;

  border-radius: 15px;
  border: 1px solid var(--qfs-border);

  background: var(--qfs-panel);
  color: var(--qfs-text);
  outline: none;
}

.layout {
  display: grid;
  grid-template-columns: 280px minmax(0,1fr);
  min-height: calc(100vh - 72px);
}

.sidebar {
  border-right: 1px solid var(--qfs-border);
  background: rgba(12,14,21,.96);
  padding: 18px;

  position: sticky;
  top: 72px;
  height: calc(100vh - 72px);

  overflow-y: auto;
}

.sidebar-section {
  margin-bottom: 22px;
}

.sidebar-title {
  color: var(--qfs-muted);
  font-size: 12px;
  text-transform: uppercase;
  margin: 8px 10px;
}

.nav {
  width: 100%;
  display: flex;
  align-items: center;
  gap: 12px;

  padding: 13px 14px;
  margin-bottom: 5px;

  background: transparent;
  border-color: transparent;
  text-align: start;
}

.nav.active {
  background:
    linear-gradient(
      90deg,
      rgba(124,92,255,.22),
      rgba(124,92,255,.06)
    );

  border-color: rgba(124,92,255,.3);
}

.main {
  min-width: 0;
  padding: 22px;
}

.dashboard-grid {
  display: grid;
  grid-template-columns:
    repeat(auto-fit,minmax(210px,1fr));

  gap: 15px;
}

.dashboard-card {
  padding: 20px;
  border: 1px solid var(--qfs-border);
  border-radius: var(--qfs-radius);
  background: var(--qfs-panel);

  min-height: 130px;
}

.dashboard-card h3 {
  margin: 0 0 10px;
  font-size: 15px;
}

.dashboard-card .big {
  font-size: 30px;
  font-weight: 800;
}

.storage-card {
  grid-column: 1 / -1;
  min-height: 190px;
}

.storage-bar {
  height: 14px;
  margin-top: 18px;

  border-radius: 100px;
  overflow: hidden;

  background: #202431;
}

.storage-bar > div {
  height: 100%;
  width: 0;

  border-radius: inherit;

  background:
    linear-gradient(
      90deg,
      var(--qfs-accent),
      var(--qfs-accent2)
    );

  transition: width .4s ease;
}

.quick-grid {
  display: grid;
  grid-template-columns:
    repeat(auto-fit,minmax(150px,1fr));

  gap: 12px;
}

.quick-card {
  padding: 20px;

  min-height: 120px;

  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 8px;

  border: 1px solid var(--qfs-border);
  border-radius: var(--qfs-radius);

  background: var(--qfs-panel);

  cursor: pointer;
}

.quick-card-icon {
  font-size: 30px;
}

.quick-card-title {
  font-weight: 700;
}

.file-toolbar {
  display: flex;
  gap: 9px;
  flex-wrap: wrap;

  padding: 15px;

  border: 1px solid var(--qfs-border);
  border-radius: var(--qfs-radius);

  background: var(--qfs-panel);

  margin-bottom: 15px;
}

.file-grid {
  display: grid;

  grid-template-columns:
    repeat(
      auto-fill,
      minmax(170px,1fr)
    );

  gap: 14px;
}

.file {
  min-height: 165px;

  padding: 17px;

  display: flex;
  flex-direction: column;
  justify-content: center;

  gap: 9px;

  border: 1px solid var(--qfs-border);
  border-radius: 18px;

  background:
    linear-gradient(
      180deg,
      rgba(255,255,255,.035),
      rgba(255,255,255,.015)
    );

  transition:
    transform .15s,
    border-color .15s,
    background .15s;
}

.file:hover {
  transform: translateY(-2px);
  border-color: rgba(124,92,255,.35);
}

.file.selected {
  border-color: var(--qfs-accent);
  background: rgba(124,92,255,.15);
}

.file-icon {
  font-size: 45px;
}

.file-name {
  font-weight: 700;
  word-break: break-word;
}

.file-meta {
  display: flex;
  justify-content: space-between;

  color: var(--qfs-muted);
  font-size: 12px;
}

.editor-layout {
  display: grid;
  grid-template-columns: 1fr;
  gap: 14px;
}

.editor-toolbar {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
}

#editor {
  width: 100%;
  min-height: 65vh;

  padding: 20px;

  resize: vertical;

  border:
    1px solid var(--qfs-border);

  border-radius: 18px;

  background: #07090d;

  color: #e9edf7;

  font-family:
    "JetBrains Mono",
    "Fira Code",
    monospace;

  font-size: 14px;

  line-height: 1.7;

  outline: none;
}

.terminal-panel {
  display: flex;
  flex-direction: column;

  min-height: 70vh;

  border: 1px solid var(--qfs-border);
  border-radius: 18px;

  background: #050609;

  overflow: hidden;
}

.terminal-output {
  flex: 1;
  padding: 18px;

  overflow: auto;

  white-space: pre-wrap;

  font-family:
    monospace;

  color: #dce4f7;
}

.terminal-input-row {
  display: flex;
  gap: 8px;

  padding: 12px;

  border-top: 1px solid var(--qfs-border);
}

.terminal-input-row input {
  flex: 1;

  min-height: 50px;

  padding: 0 15px;

  border-radius: 12px;

  background: #10131a;
  border: 1px solid var(--qfs-border);

  color: white;

  outline: none;
}

.primary-btn {
  background:
    linear-gradient(
      135deg,
      var(--qfs-accent),
      var(--qfs-accent2)
    );

  border: none;

  font-weight: 800;
}

.secondary-btn {
  background: var(--qfs-panel2);
}

.modal-overlay {
  position: fixed;
  inset: 0;

  z-index: 200;

  display: flex;
  align-items: center;
  justify-content: center;

  padding: 20px;

  background: rgba(0,0,0,.72);

  backdrop-filter: blur(10px);
}

.update-card {
  width: min(560px,100%);

  padding: 28px;

  border:
    1px solid var(--qfs-border);

  border-radius: 25px;

  background: #11151e;

  box-shadow:
    0 30px 100px rgba(0,0,0,.5);
}

.update-icon {
  width: 65px;
  height: 65px;

  display: grid;
  place-items: center;

  border-radius: 18px;

  background: rgba(124,92,255,.15);

  color: #a998ff;

  font-size: 34px;
}

.version-box {
  display: grid;

  grid-template-columns: 1fr auto 1fr;

  align-items: center;

  gap: 15px;

  margin: 22px 0;

  padding: 18px;

  border-radius: 16px;

  background: #0a0d13;
}

.version-box div:not(.version-arrow) {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.version-box small {
  color: var(--qfs-muted);
}

.version-box strong {
  font-size: 20px;
}

.version-arrow {
  font-size: 25px;
}

.update-actions {
  display: flex;
  gap: 10px;
  margin-top: 25px;
}

.update-actions button {
  flex: 1;
}

@media(max-width:900px) {

  .layout {
    grid-template-columns: 1fr;
  }

  .sidebar {
    position: fixed;

    left: 0;
    top: 72px;

    width: 290px;

    z-index: 100;

    transform: translateX(-105%);

    transition: transform .2s;
  }

  .sidebar.open {
    transform: translateX(0);
  }

  .main {
    padding: 14px;
  }

  .file-grid {
    grid-template-columns:
      repeat(
        auto-fill,
        minmax(145px,1fr)
      );
  }
}

@media(max-width:600px) {

  .topbar {
    padding: 10px;
  }

  .brand {
    font-size: 18px;
  }

  .top-search {
    display: none;
  }

  .main {
    padding: 10px;
  }

  .file-grid {
    grid-template-columns:
      repeat(2,minmax(0,1fr));
  }

  .file {
    min-height: 145px;
  }

  .quick-grid {
    grid-template-columns:
      repeat(2,minmax(0,1fr));
  }

  .version-box {
    grid-template-columns: 1fr;
  }

  .version-arrow {
    display: none;
  }
}


/* ===== Quick File Studio Professional UI ===== */

.menu-wrap {
  position: relative;
  display: inline-flex;
}

.popup-menu {
  position: absolute;
  top: calc(100% + 8px);
  right: 0;
  min-width: 210px;
  padding: 8px;
  border: 1px solid rgba(255,255,255,.10);
  border-radius: 14px;
  background: rgba(15,17,24,.98);
  box-shadow: 0 18px 50px rgba(0,0,0,.45);
  z-index: 1000;
}

.popup-menu.hidden {
  display: none;
}

.popup-menu button {
  width: 100%;
  display: block;
  padding: 11px 13px;
  border: 0;
  border-radius: 9px;
  background: transparent;
  color: inherit;
  text-align: right;
  cursor: pointer;
}

.popup-menu button:hover {
  background: rgba(124,92,255,.16);
}

.popup-menu button:active {
  transform: scale(.98);
}

.toolbar,
.editor-toolbar {
  display: flex;
  align-items: center;
  gap: 8px;
  flex-wrap: wrap;
}

.editor-spacer {
  flex: 1;
}

#editorMode {
  opacity: .65;
  font-size: 13px;
}

.file-grid {
  min-height: 55vh;
}

.file-card,
.file-item,
.file-grid > * {
  transition: transform .15s ease,
              border-color .15s ease,
              background .15s ease;
}

.file-grid > *:hover {
  transform: translateY(-2px);
}

#editor {
  width: 100%;
  min-height: 65vh;
  resize: vertical;
  tab-size: 4;
  font-family: "JetBrains Mono", "Fira Code", monospace;
  line-height: 1.6;
}

.editor-meta {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  padding: 8px 4px;
}

@media (max-width: 700px) {
  .popup-menu {
    position: fixed;
    top: auto;
    right: 10px;
    left: 10px;
    bottom: 10px;
    width: auto;
    min-width: 0;
  }

  .toolbar,
  .editor-toolbar {
    gap: 5px;
  }
}


.editor-tabs {
  display: flex;
  align-items: center;
  gap: 4px;
  overflow-x: auto;
  padding: 6px;
  border-bottom: 1px solid rgba(255,255,255,.08);
}

.editor-tab,
.editor-tab-add {
  border: 0;
  background: rgba(255,255,255,.05);
  color: inherit;
  padding: 8px 12px;
  border-radius: 8px;
  white-space: nowrap;
}

.editor-tab.active {
  background: rgba(120,120,255,.18);
}

.editor-tab b {
  margin-inline: 5px;
}

.tab-close {
  margin-inline-start: 8px;
  opacity: .7;
}

.editor-tab-add {
  font-size: 18px;
  cursor: pointer;
}

#editor {
  font-family: "JetBrains Mono","Fira Code","Cascadia Mono",monospace;
  tab-size: 4;
  line-height: 1.55;
  direction: ltr;
  text-align: left;
}

.editor-status {
  display: flex;
  gap: 14px;
  flex-wrap: wrap;
  padding: 7px 10px;
  font-size: 12px;
  opacity: .8;
  border-top: 1px solid rgba(255,255,255,.08);
}

.editor-mini-toolbar {
  display: flex;
  gap: 5px;
  overflow-x: auto;
  padding: 6px;
}

.editor-mini-toolbar button {
  min-width: 38px;
}

/* QFS SIDEBAR FIX */
.sidebar {
  transform: translateX(100%);
  visibility: hidden;
  pointer-events: none;
  transition: transform .22s ease, visibility 0s linear .22s;
}

.sidebar.open {
  transform: translateX(0);
  visibility: visible;
  pointer-events: auto;
  transition: transform .22s ease, visibility 0s linear 0s;
}

@media (min-width: 801px) {
  .sidebar {
    transform: translateX(100%);
    visibility: hidden;
    pointer-events: none;
  }

  .sidebar.open {
    transform: translateX(0);
    visibility: visible;
    pointer-events: auto;
  }

  .content {
    margin-right: 0;
  }
}
