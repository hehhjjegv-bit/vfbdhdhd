:root{--bg:#090b10;--panel:#10141c;--panel2:#151b25;--line:#273041;--text:#edf2f7;--muted:#8e9aaa;--accent:#8b5cf6;--danger:#ef4444;--ok:#22c55e}
*{box-sizing:border-box}html,body{margin:0;height:100%;background:var(--bg);color:var(--text);font-family:system-ui,-apple-system,Segoe UI,Tahoma,sans-serif}button,input,textarea,select{font:inherit}button{background:var(--panel2);border:1px solid var(--line);color:var(--text);border-radius:10px;padding:9px 12px;cursor:pointer}button:hover{border-color:var(--accent)}button.primary{background:var(--accent);border-color:var(--accent);color:#fff}.topbar{height:58px;display:flex;align-items:center;gap:10px;padding:0 12px;border-bottom:1px solid var(--line);position:sticky;top:0;z-index:5;background:#090b10eF;backdrop-filter:blur(12px)}.brand{display:flex;flex-direction:column;flex:1}.brand span{font-size:11px;color:var(--muted)}.top-actions{display:flex;gap:6px}.icon-btn{width:42px;padding:8px}.sidebar{position:fixed;right:0;top:58px;bottom:0;width:220px;background:var(--panel);border-left:1px solid var(--line);padding:12px;z-index:4;transform:translateX(0);transition:.2s}.nav{width:100%;text-align:right;margin-bottom:7px;background:transparent}.nav.active{background:var(--accent)}.content{margin-right:220px;padding:16px;min-height:calc(100vh - 58px)}.page{display:none}.page.active{display:block}.toolbar,.subbar,.editor-toolbar,.console-head,.console-input,.section-head,.subbar{display:flex;gap:8px;align-items:center;margin-bottom:12px}.crumbs{display:flex;gap:5px;overflow:auto;padding:8px 0;color:var(--muted)}.crumb{white-space:nowrap}.search-row input,.console-input input,.tool input,.tool textarea,.modal-card input,.modal-card select{width:100%;background:#0c1017;border:1px solid var(--line);color:var(--text);border-radius:9px;padding:10px}.hidden{display:none!important}.subbar{justify-content:space-between;color:var(--muted);font-size:13px}.file-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(155px,1fr));gap:10px}.file{background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:12px;min-height:115px;display:flex;flex-direction:column;gap:7px}.file.selected{border-color:var(--accent);box-shadow:0 0 0 1px var(--accent)}.file-icon{font-size:30px}.file-name{font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.file-meta{font-size:11px;color:var(--muted);display:flex;justify-content:space-between}.cards{display:grid;gap:10px}.card{background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:14px}.section-head{justify-content:space-between}.editor-meta{display:flex;justify-content:space-between;color:var(--muted);font-size:12px;margin-bottom:6px}.editor-toolbar{flex-wrap:wrap}.editor-toolbar button{font-size:13px}.editor{width:100%}#editor{width:100%;height:calc(100vh - 190px);resize:none;background:#080b10;color:#e5e7eb;border:1px solid var(--line);border-radius:10px;padding:14px;font:13px ui-monospace,SFMono-Regular,Consolas,monospace;direction:ltr;text-align:left;tab-size:2}.tool-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:12px}.tool{background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:14px}.tool h3{margin-top:0}.tool textarea{height:150px;resize:vertical}.tool button{margin:6px 4px 0 0}.tool pre{background:#080b10;border:1px solid var(--line);padding:10px;min-height:30px;overflow:auto;white-space:pre-wrap}.console{background:#05070a;border:1px solid var(--line);border-radius:10px;height:calc(100vh - 190px);padding:12px;overflow:auto;font:13px ui-monospace,monospace;direction:ltr;text-align:left;white-space:pre-wrap}.console-input{background:#05070a;border:1px solid var(--line);padding:8px;border-radius:10px}.console-input input{border:0;outline:0;background:transparent;color:#fff;direction:ltr}.modal{position:fixed;inset:0;background:#0009;z-index:20;display:grid;place-items:center;padding:18px}.modal-card{background:var(--panel);border:1px solid var(--line);border-radius:14px;max-width:600px;width:100%;max-height:85vh;overflow:auto;padding:16px}.modal-head{display:flex;justify-content:space-between;align-items:center}.modal-head h3{margin:0 0 14px}.modal-actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}.danger{color:#fff;background:var(--danger)}@media(max-width:800px){.sidebar{width:180px}.content{margin-right:0;padding-bottom:72px}.sidebar{transform:translateX(100%)}.sidebar.open{transform:translateX(0)}.file-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.topbar{position:sticky}.tool-grid{grid-template-columns:1fr}}
