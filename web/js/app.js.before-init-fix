  $('#ctxMove').onclick=async()=>{closeModal();const dest=prompt('URI للمجلد الهدف',state.cwd);if(!dest)return;try{await call('move',{sourceUri:e.uri,targetParentUri:dest});log('نقل',e.name);loadDir()}catch(x){toast(x.message)}};
  $('#ctxDup').onclick=async()=>{closeModal();try{await call('duplicate',{sourceUri:e.uri,targetParentUri:state.cwd});log('تكرار',e.name);loadDir()}catch(x){toast(x.message)}};
  $('#ctxZip').onclick=async()=>{closeModal();try{const r=await call('zip',{uri:e.uri});log('ضغط ZIP',e.name);toast(r.name||'تم إنشاء ZIP');loadDir()}catch(x){toast(x.message)}};
  $('#ctxHash').onclick=async()=>{try{const r=await call('sha256',{uri:e.uri});modal('SHA-256',`<pre>${esc(r.hash)}</pre>`)}catch(x){toast(x.message)}};
  $('#ctxDelete').onclick=async()=>{
  closeModal();

  if(e.name === '.qfs_trash'){
    toast('مجلد سلة المحذوفات محمي');
    return;
  }

  if(e.canMove === false){
    toast('مزود الملفات لا يدعم نقل هذا العنصر');
    return;
  }

  if(!confirm(`نقل ${e.name} إلى سلة المحذوفات؟`)){
    return;
  }

  try{
    const trashFolder=await ensureTrashFolder();

    const moved=await call('move',{
      sourceUri:e.uri,
      sourceParentUri:state.cwd,
      targetParentUri:trashFolder
    });

    const trashUri=moved?.uri||'';

    if(!trashUri){
      throw new Error('تعذر نقل العنصر إلى السلة');
    }

    state.trash.unshift({
      name:e.name,
      originalName:e.name,
      uri:trashUri,
      trashFolderUri:trashFolder,
      originalParentUri:state.cwd,
      originalParentName:state.cwd===state.root
        ? 'الجذر'
        : 'المجلد الأصلي',
      deletedAt:Date.now()
    });

    localStorage.setItem(
      'qfs.trash',
      JSON.stringify(state.trash)
    );

    log('نقل إلى السلة',e.name);

    await loadDir(state.cwd);

    toast('تم نقل العنصر إلى سلة المحذوفات');
  }catch(x){
    toast(
      x?.message ||
      'تعذر نقل العنصر إلى سلة المحذوفات'
    );
  }
};
}


