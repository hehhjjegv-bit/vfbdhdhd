async function ensureTrashFolder(){
  if(!state.root){
    throw new Error('اختر مجلدًا أولًا');
  }

  const saved = localStorage.getItem('qfs.trashFolderUri') || '';

  if(saved){
    try{
      const existing = await call('list', {
        uri: state.root
      });

      const items = Array.isArray(existing)
        ? existing
        : (Array.isArray(existing?.items) ? existing.items : []);

      const savedItem = items.find(
        x => x.uri === saved && x.name === '.qfs_trash'
      );

      if(savedItem){
        return saved;
      }
    }catch(e){
      console.warn('تعذر التحقق من مجلد السلة المحفوظ:', e);
    }

    localStorage.removeItem('qfs.trashFolderUri');
  }

  try{
    const existing = await call('list', {
      uri: state.root
    });

    const items = Array.isArray(existing)
      ? existing
      : (Array.isArray(existing?.items) ? existing.items : []);

    const trash = items.find(
      x => x.name === '.qfs_trash' && x.dir
    );

    if(trash?.uri){
      localStorage.setItem(
        'qfs.trashFolderUri',
        trash.uri
      );

      return trash.uri;
    }
  }catch(e){
    console.warn('تعذر البحث عن مجلد السلة:', e);
  }

  const r = await call('createFolder', {
    parent: state.root,
    name: '.qfs_trash'
  });

  const uri = r?.uri || '';

  if(!uri){
    throw new Error(
      'تعذر إنشاء مجلد سلة المحذوفات'
    );
  }

  localStorage.setItem(
    'qfs.trashFolderUri',
    uri
  );

  return uri;
}

function renderTrash(){
  const box = $('#trashList');

  if(!box){
    return;
  }

  if(!state.trash.length){
    box.innerHTML = '<div class="card">السلة فارغة.</div>';
    return;
  }

  box.innerHTML = state.trash.map((x,i)=>`
    <div class="card">
      <b>🗑️ ${esc(x.name || 'بدون اسم')}</b>
      <div class="file-meta">
        ${new Date(x.deletedAt || Date.now()).toLocaleString()}
      </div>
      <div class="file-meta">
        ${esc(x.originalParentName || 'المجلد الأصلي')}
      </div>
      <div class="modal-actions">
        <button onclick="restoreTrash(${i})">استعادة</button>
        <button class="danger" onclick="permanentTrash(${i})">حذف نهائي</button>
      </div>
    </div>
  `).join('');
}

window.restoreTrash = async i => {
  const x = state.trash[i];

  if(!x){
    return;
  }

  try{
    if(!x.uri || !x.originalParentUri){
      throw new Error('بيانات الاستعادة غير مكتملة');
    }

    const moved = await call('move', {
      sourceUri: x.uri,
      sourceParentUri: x.trashFolderUri,
      targetParentUri: x.originalParentUri
    });

    let restoredUri = moved?.uri || '';

    if(!restoredUri){
      throw new Error('تعذر نقل العنصر من السلة');
    }

    if(x.originalName){
      const renamed = await call('rename', {
        uri: restoredUri,
        name: x.originalName
      });

      if(renamed?.uri){
        restoredUri = renamed.uri;
      }
    }

    state.trash.splice(i,1);

    localStorage.setItem(
      'qfs.trash',
      JSON.stringify(state.trash)
    );

    renderTrash();

    log('استعادة', x.originalName || x.name || '');

    if(state.cwd){
      await loadDir(state.cwd);
    }

    toast('تمت استعادة العنصر بنجاح');
  }catch(e){
    console.error(e);
    toast('لا يمكن الاستعادة: ' + (e?.message || 'خطأ غير معروف'));
  }
};

window.permanentTrash = async i => {
  const x = state.trash[i];

  if(!x){
    return;
  }

  if(!confirm(`حذف ${x.originalName || x.name || 'العنصر'} نهائيًا؟`)){
    return;
  }

  try{
    if(!x.uri){
      throw new Error('URI السلة غير موجود');
    }

    await call('delete', {
      uri: x.uri
    });

    state.trash.splice(i,1);

    localStorage.setItem(
      'qfs.trash',
      JSON.stringify(state.trash)
    );

    renderTrash();

    log('حذف نهائي', x.originalName || x.name || '');

    toast('تم الحذف نهائيًا');
  }catch(e){
    console.error(e);
    toast(e?.message || 'تعذر الحذف النهائي');
  }
};

async function emptyTrash(){
  if(!state.trash.length){
    toast('السلة فارغة');
    return;
  }

  if(!confirm('حذف جميع عناصر السلة نهائيًا؟')){
    return;
  }

  const items = [...state.trash];
  const failedItems = [];
  let deletedCount = 0;

  for(const item of items){
    try{
      if(!item.uri){
        throw new Error('URI غير موجود');
      }

      await call('delete', {
        uri: item.uri
      });

      deletedCount++;
    }catch(e){
      failedItems.push(item);
      console.error('Trash delete failed:', item, e);
    }
  }

  state.trash = failedItems;

  localStorage.setItem(
    'qfs.trash',
    JSON.stringify(state.trash)
  );

  renderTrash();

  log(
    'إفراغ السلة',
    failedItems.length
      ? `تم حذف ${deletedCount} عنصر وتعذر حذف ${failedItems.length}`
      : `تم حذف ${deletedCount} عنصر`
  );

  toast(
    failedItems.length
      ? `تم حذف ${deletedCount} وتعذر حذف ${failedItems.length}`
      : `تم إفراغ السلة: ${deletedCount} عنصر`
  );
}

