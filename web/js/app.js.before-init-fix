'use strict';

const state = {
  cwd: null, root: null, entries: [], selected: new Set(), sort: 'name',
  userFilesRoot: null, userFilesCwd: null, userFilesEntries: [],
  editorUri: null, editorName: '', editorDirty: false, editorCanWrite: true, editorReturnPage: 'files',
  settings: JSON.parse(localStorage.getItem('qfs.settings') || '{"theme":"dark","lang":"ar","autosave":true}'),
  activity: JSON.parse(localStorage.getItem('qfs.activity') || '[]'),
  trash: JSON.parse(localStorage.getItem('qfs.trash') || '[]'),
  projects: JSON.parse(localStorage.getItem('qfs.projects') || '[]')
};

const $ = s => document.querySelector(s);
const $$ = s => [...document.querySelectorAll(s)];
const native = () => typeof window.AndroidBridge !== 'undefined';
const esc = s => String(s ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const bytes = n => { n=Number(n)||0; const u=['B','KB','MB','GB']; let i=0; while(n>=1024&&i<3){n/=1024;i++} return `${n.toFixed(i?1:0)} ${u[i]}`; };
const toast = msg => {
  const status = $('#statusText');
  if (status) status.textContent = msg;
  clearTimeout(toast.t);
  toast.t = setTimeout(() => {
    const el = $('#statusText');
    if (el) el.textContent = 'جاهز';
  }, 2200);
};
function log(action, detail=''){ state.activity.unshift({time:new Date().toISOString(),action,detail}); state.activity=state.activity.slice(0,300); localStorage.setItem('qfs.activity',JSON.stringify(state.activity)); renderActivity(); }
function call(name,args={}) {
  if (!native()) return Promise.reject(new Error('Native Android bridge unavailable'));
  return new Promise((resolve,reject)=>{
    const id='cb_'+Date.now()+'_'+Math.random().toString(36).slice(2);
    window.__qfsCallbacks ||= {};
    window.__qfsCallbacks[id]={resolve,reject};
    try { window.AndroidBridge.call(JSON.stringify({id, command:name, args})); } catch(e){ reject(e); }
  });
}
window.qfsNativeCall = call;

window.qfsResult = function(id, ok, payload) {
  const cb = window.__qfsCallbacks?.[id];
  if (!cb) return;

  delete window.__qfsCallbacks[id];

  let value = payload;
  try {
    if (typeof payload === 'string') value = JSON.parse(payload);
  } catch (_) {}

  if (ok) {
    cb.resolve(value);
  } else {
    const message = typeof value === 'string'
      ? value
      : (value?.error || 'حدث خطأ في Android Bridge');
    cb.reject(new Error(message));
  }
};


function applyTheme(){
  const theme = state.settings.theme === 'light' ? 'light' : 'dark';

  document.documentElement.setAttribute('data-theme', theme);

  const btn = $('#themeBtn');

  if (btn) {
    btn.textContent = theme === 'dark' ? '☀️' : '🌙';
    btn.title = theme === 'dark'
      ? 'التبديل إلى الوضع النهاري'
      : 'التبديل إلى الوضع الليلي';

    btn.setAttribute(
      'aria-label',
      theme === 'dark'
        ? 'التبديل إلى الوضع النهاري'
        : 'التبديل إلى الوضع الليلي'
    );
  }

  const meta = document.querySelector('meta[name="theme-color"]');

  if (meta) {
    meta.setAttribute(
      'content',
      theme === 'dark' ? '#080a0f' : '#f4f6fa'
    );
  }
}

function toggleTheme(){
  state.settings.theme =
    state.settings.theme === 'light' ? 'dark' : 'light';

  localStorage.setItem(
    'qfs.settings',
    JSON.stringify(state.settings)
  );

  applyTheme();

  if (typeof toast === 'function') {
    toast(
      state.settings.theme === 'dark'
        ? 'تم تفعيل الوضع الليلي'
        : 'تم تفعيل الوضع النهاري'
    );
  }
}

async function init(){
  applyTheme();
  bind();
  renderActivity(); renderTrash(); renderProjects();
  if(native()){
    try{
      const saved=await call('getWorkspace');

      // مساحة العمل الرئيسية
      const root=saved?.uri || saved?.treeUri || '';
      const permission=saved?.storagePermission === true;

      // مساحة "ملفاتك" مستقلة عن مساحة العمل الرئيسية
      const userFilesRoot =
        saved?.userFilesTreeUri || '';

      const userFilesPermission =
        saved?.userFilesStoragePermission === true;

      if(root && permission){
        state.root=root;
        state.cwd=root;

        try{
          await loadDir();
        }catch(e){
          state.root=null;
          state.cwd=null;
          state.entries=[];
          console.warn('تعذر استعادة مجلد العمل:', e);
          toast('انتهت صلاحية مجلد العمل، اختر مجلدًا جديدًا');
        }
      }else if(root && !permission){
        state.root=null;
        state.cwd=null;
        state.entries=[];
        console.warn('لا توجد صلاحية لمجلد العمل المحفوظ');
      }

      // استعادة مجلد "ملفاتك" بشكل مستقل
      if(userFilesRoot && userFilesPermission){
        state.userFilesRoot=userFilesRoot;
        state.userFilesCwd=userFilesRoot;

        try{
          await loadUserFilesDir(userFilesRoot);
        }catch(e){
          state.userFilesRoot=null;
          state.userFilesCwd=null;
          state.userFilesEntries=[];

          console.warn(
            'تعذر استعادة مجلد ملفاتك:',
            e
          );

          toast(
            'انتهت صلاحية مجلد ملفاتك، اختر مجلدًا جديدًا'
          );
        }
      }else if(userFilesRoot && !userFilesPermission){
        state.userFilesRoot=null;
        state.userFilesCwd=null;
        state.userFilesEntries=[];

        console.warn(
          'لا توجد صلاحية لمجلد ملفاتك المحفوظ'
        );
      }

      renderUserFiles();

    }catch(e){
      console.warn(e)
    }
  } else toast('وضع المتصفح');
}
function bind(){

  const on = (selector, event, handler) => {
    const el = $(selector);
    if (!el) {
      console.warn('[QFS] Missing element:', selector);
      return false;
    }
    el.addEventListener(event, handler);
    return true;
  };

  const click = (selector, handler) =>
    on(selector, 'click', handler);

  const input = (selector, handler) =>
    on(selector, 'input', handler);

  const change = (selector, handler) =>
    on(selector, 'change', handler);

  const keydown = (selector, handler) =>
    on(selector, 'keydown', handler);

  click('#editorBackBtn', returnFromEditor);
  click('#editorBack', returnFromEditor);

  click('#menuBtn', () => {
    const sidebar = $('#sidebar');
    if (sidebar) sidebar.classList.toggle('open');
  });

  $$('.nav').forEach(b => {
    b.addEventListener('click', () => showPage(b.dataset.page));
  });

  click('#chooseFolderBtn', chooseFolder);
  click('#refreshBtn', loadDir);

  click('#userFilesChooseBtn', chooseUserFilesFolder);
  click('#userFilesStartBtn', chooseUserFilesFolder);
  click('#userFilesRefreshBtn', refreshUserFiles);

  input('#userFilesSearch', renderUserFiles);

  click('#selectAllMenu', () => {
    state.entries.forEach(e => {
      if (e.uri) state.selected.add(e.uri);
    });
    renderFiles();
  });

  click('#clearSelectionMenu', () => {
    state.selected.clear();
    renderFiles();
  });

  click('#newBtn', newItemMenu);

  click('#sortMenuBtn', () => {
    const menu = $('#sortMenu');
    if (menu) menu.classList.toggle('hidden');
  });

  const sortMenu = $('#sortMenu');
  if (sortMenu) {
    sortMenu.querySelectorAll('button[data-sort]').forEach(b => {
      b.addEventListener('click', () => {
        state.sort = b.dataset.sort || 'name';

        const select = $('#sortSelect');
        if (select) {
          select.value =
            state.sort === 'modified'
              ? 'date'
              : state.sort;
        }

        sortMenu.classList.add('hidden');
        renderFiles();
      });
    });
  }

  click('#searchBtn', () => {
    const row = $('#searchRow');
    if (row) row.classList.toggle('hidden');
  });

  input('#fileSearch', renderFiles);

  change('#sortSelect', e => {
    state.sort = e.target.value === 'date'
      ? 'modified'
      : e.target.value;
    renderFiles();
  });

  click('#themeBtn', toggleTheme);

  click('#settingsBtn', settingsModal);

  click('#saveEditorBtn', saveEditor);
  click('#saveAsBtn', saveAs);
  click('#openEditorBtn', openEditorPicker);
  click('#previewBtn', previewHtml);
  click('#formatBtn', formatEditor);

  input('#editor', () => {
    state.editorDirty = true;
    updateEditorStats();

    if (state.settings.autosave) {
      clearTimeout(window.auto);
      window.auto = setTimeout(saveEditor, 900);
    }
  });

  click('#newProjectBtn', newProject);
  click('#openProjectBtn', openExistingProject);

  click('#clearConsole', () => {
    const out = $('#consoleOut');
    if (out) out.textContent = '';
  });

  click('#runCmd', runCmd);

  keydown('#cmdInput', e => {
    if (e.key === 'Enter') runCmd();
  });

  click('#emptyTrash', emptyTrash);

  click('#clearActivity', () => {
    state.activity = [];
    localStorage.removeItem('qfs.activity');
    renderActivity();
  });

  [
    'jsonPretty',
    'jsonMin',
    'b64Enc',
    'b64Dec',
    'urlEnc',
    'urlDec',
    'regexRun',
    'hashRun',
    'uuidRun'
  ].forEach(id => {
    const el = document.getElementById(id);
    const fn = window[id];

    if (el && typeof fn === 'function') {
      el.addEventListener('click', fn);
    }
  });

  input('#colorPick', e => {
    const out = $('#colorOut');
    if (out) out.value = e.target.value;
  });

  applyTheme();
}

/* QFS 1.3.0 - User Files */

async function chooseUserFilesFolder(){
  try{
    if(!native()){
      toast('هذه الميزة تحتاج نسخة Android من التطبيق');
      return;
    }

    const r = await call('chooseUserFilesFolder');

    if(!r?.uri){
      return;
    }

    state.userFilesRoot = r.uri;
    state.userFilesCwd = r.uri;
    state.userFilesEntries = [];
    state.userFilesHistory = [r.uri];

    log('اختيار مجلد ملفاتك', r.name || r.uri);

    await loadUserFilesDir(r.uri);
    renderUserFiles();

    toast('تم اختيار مجلد ملفاتك بنجاح');
  }catch(e){
    console.error(e);
    toast(e?.message || 'تعذر اختيار المجلد');
  }
}

async function loadUserFilesDir(uri, options = {}){
  if(!uri){
    throw new Error('اختر مجلد ملفاتك أولًا');
  }

  const r = await call('list', {uri});

  const entries = Array.isArray(r)
    ? r
    : (Array.isArray(r?.items) ? r.items : []);

  state.userFilesCwd = uri;

  state.userFilesEntries = entries.map(e => ({
    ...e,
    uri: e.uri || e.documentUri || ''
  }));

  if(!Array.isArray(state.userFilesHistory)){
    state.userFilesHistory = [];
  }

  if(options.resetHistory){
    state.userFilesHistory = [uri];
  }else if(options.pushHistory !== false){
    const last =
      state.userFilesHistory[state.userFilesHistory.length - 1];

    if(last !== uri){
      state.userFilesHistory.push(uri);
    }
  }

  return state.userFilesEntries;
}


async function userFilesRename(entry){
  if(!entry?.uri){
    return;
  }

  const name = prompt(
    'الاسم الجديد:',
    entry.name || ''
  );

  if(!name || !name.trim()){
    return;
  }

  try{
    await call('rename',{
      uri: entry.uri,
      name: name.trim()
    });

    await refreshUserFiles();
    toast('تمت إعادة التسمية');
  }catch(e){
    console.error(e);
    toast(e?.message || 'تعذرت إعادة التسمية');
  }
}

async function userFilesDelete(entry){
  if(!entry?.uri){
    return;
  }

  if(!confirm(`هل تريد حذف "${entry.name || 'هذا العنصر'}"؟`)){
    return;
  }

  try{
    await call('delete',{
      uri: entry.uri
    });

    await refreshUserFiles();
    toast('تم الحذف');
  }catch(e){
    console.error(e);
    toast(e?.message || 'تعذر الحذف');
  }
}

async function refreshUserFiles(){
  if(!state.userFilesCwd){
    renderUserFiles();
    return;
  }

  try{
    await loadUserFilesDir(state.userFilesCwd);
    renderUserFiles();
    toast('تم تحديث ملفاتك');
  }catch(e){
    toast(e?.message || 'تعذر تحديث الملفات');
  }
}

function renderUserFiles(){
  const gate = $('#userFilesGate');
  const content = $('#userFilesContent');
  const status = $('#userFilesStatus');

  if(!gate || !content){
    return;
  }

  if(!state.userFilesRoot){
    gate.classList.remove('hidden');
    content.classList.add('hidden');

    if(status){
      status.textContent =
        'اختر مجلدًا من جهازك ليصبح مساحة ملفاتك داخل التطبيق.';
    }

    return;
  }

  gate.classList.add('hidden');
  content.classList.remove('hidden');

  if(status){
    status.textContent =
      state.userFilesCwd === state.userFilesRoot
        ? 'مجلد ملفاتك الرئيسي'
        : 'أنت داخل مجلد فرعي من ملفاتك';
  }

  const query = ($('#userFilesSearch')?.value || '')
    .trim()
    .toLowerCase();

  let entries = [...state.userFilesEntries];

  if(query){
    entries = entries.filter(e =>
      String(e.name || '').toLowerCase().includes(query)
    );
  }

  const count = $('#userFilesCount');

  if(count){
    count.textContent = `${entries.length} عنصر`;
  }

  renderUserFilesCrumbs();

  const grid = $('#userFilesGrid');

  if(!grid){
    return;
  }

  if(!entries.length){
    grid.innerHTML = `
      <div class="empty-state">
        <div>📂</div>
        <p>لا توجد ملفات أو مجلدات هنا</p>
      </div>
    `;
    return;
  }

  grid.innerHTML = entries.map(e => {
    const uri = esc(e.uri || '');
    const name = esc(e.name || 'بدون اسم');

    const icon = e.dir
      ? '📁'
      : getUserFileIcon(e.name || '', e.mime || '');

    const size = e.dir
      ? 'مجلد'
      : bytes(Number(e.size || 0));

    return `
      <div
        class="file"
        data-user-uri="${uri}"
        role="button"
        tabindex="0"
      >
        <div class="file-icon">${icon}</div>
        <div class="file-name">${name}</div>
        <div class="file-meta">${size}</div>
      </div>
    `;
  }).join('');

  grid.querySelectorAll('[data-user-uri]').forEach(el => {
    const uri = el.dataset.userUri;
    const entry = entries.find(e => e.uri === uri);

    if(!entry){
      return;
    }

    el.addEventListener('click', () => openUserFile(entry));

    el.addEventListener('contextmenu', e => {
      e.preventDefault();
      userFilesContextMenu(entry);
    });

    let pressTimer = null;

    el.addEventListener('pointerdown', () => {
      pressTimer = setTimeout(() => {
        pressTimer = null;
        userFilesContextMenu(entry);
      }, 550);
    });

    el.addEventListener('pointerup', () => {
      if(pressTimer){
        clearTimeout(pressTimer);
        pressTimer = null;
      }
    });

    el.addEventListener('pointerleave', () => {
      if(pressTimer){
        clearTimeout(pressTimer);
        pressTimer = null;
      }
    });

    el.addEventListener('keydown', e => {
      if(e.key === 'Enter' || e.key === ' '){
        e.preventDefault();
        openUserFile(entry);
      }
    });
  });

  updateUserFilesToolbar();
}

function renderUserFilesCrumbs(){
  const box = $('#userFilesCrumbs');

  if(!box){
    return;
  }

  if(!state.userFilesRoot){
    box.innerHTML = '';
    return;
  }

  const history = Array.isArray(state.userFilesHistory)
    ? state.userFilesHistory
    : [state.userFilesRoot];

  let html = `
    <button
      class="crumb"
      id="userFilesRootCrumb"
      type="button">
      🏠 ملفاتك
    </button>
  `;

  for(let i = 1; i < history.length; i++){
    html += `
      <span class="crumb-separator">›</span>
      <button
        class="crumb ${i === history.length - 1 ? 'current' : ''}"
        type="button"
        data-user-crumb-index="${i}">
        📁 مجلد
      </button>
    `;
  }

  box.innerHTML = html;

  const root = $('#userFilesRootCrumb');

  if(root){
    root.onclick = async () => {
      try{
        await loadUserFilesDir(state.userFilesRoot, {
          resetHistory: true
        });

        renderUserFiles();
      }catch(e){
        toast(e?.message || 'تعذر الرجوع للجذر');
      }
    };
  }

  box.querySelectorAll('[data-user-crumb-index]')
    .forEach(btn => {
      btn.onclick = async () => {
        const index = Number(btn.dataset.userCrumbIndex);
        const target = history[index];

        if(!target){
          return;
        }

        try{
          state.userFilesHistory = history.slice(0, index + 1);

          await loadUserFilesDir(target, {
            pushHistory: false
          });

          renderUserFiles();
        }catch(e){
          toast(e?.message || 'تعذر فتح المجلد');
        }
      };
    });
}

async function openUserFile(entry){
  try{
    if(!entry?.uri){
      throw new Error('مسار العنصر غير صالح');
    }

    // المجلدات تُفتح داخل Quick File Studio نفسه
    if(entry.dir){
      await loadUserFilesDir(entry.uri, {
        pushHistory: true
      });

      renderUserFiles();
      return;
    }

    const name = String(entry.name || '');
    const extension = ext(name);

    // الملفات النصية تُفتح داخل محرر Quick File Studio
    if(isText(name) || extension === 'html'){
      const opened = await openEditor(entry);

      if(opened){
        state.editorReturnPage = 'user-files';
        showPage('editor');
      }

      return;
    }

    // الصور تُعرض داخل Quick File Studio
    if(/^image\//i.test(entry.mime || '') ||
       ['png','jpg','jpeg','webp','gif','bmp','svg'].includes(extension)){

      await openInternalImage(entry);
      return;
    }

    // لا نفتح تطبيقات خارجية.
    // الملفات غير المدعومة تعرض معلوماتها داخل Quick File Studio.
    await openInternalFileInfo(entry);

  }catch(e){
    console.error(e);
    toast(e?.message || 'تعذر فتح العنصر');
  }
}

async function openInternalImage(entry){
  const old = document.getElementById('qfsInternalViewer');
  if(old) old.remove();

  const overlay = document.createElement('div');
  overlay.id = 'qfsInternalViewer';
  overlay.style.cssText = `
    position:fixed;
    inset:0;
    z-index:99999;
    background:#080808;
    display:flex;
    flex-direction:column;
  `;

  overlay.innerHTML = `
    <div style="
      display:flex;
      align-items:center;
      gap:10px;
      padding:12px;
      background:#111;
      border-bottom:1px solid #333;
    ">
      <button id="qfsViewerBack" type="button">← رجوع</button>
      <strong style="flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">
        ${esc(entry.name || 'صورة')}
      </strong>
    </div>

    <div style="
      flex:1;
      display:flex;
      align-items:center;
      justify-content:center;
      overflow:auto;
      padding:15px;
    ">
      <img
        id="qfsInternalImage"
        alt=""
        style="max-width:100%;max-height:100%;object-fit:contain"
      >
    </div>
  `;

  document.body.appendChild(overlay);

  document.getElementById('qfsViewerBack')?.addEventListener('click', () => {
    overlay.remove();
  });

  try{
    const result = await call('readBase64', {
      uri: entry.uri
    });

    if(!result?.data){
      throw new Error('تعذر قراءة الصورة');
    }

    const mime = result.mime ||
      entry.mime ||
      guessMime(entry.name || '') ||
      'image/*';

    const image = document.getElementById('qfsInternalImage');

    if(!image){
      throw new Error('عارض الصور غير متوفر');
    }

    image.src = `data:${mime};base64,${result.data}`;

  }catch(e){
    overlay.remove();
    await openInternalFileInfo(
      entry,
      e?.message || 'تعذر عرض الصورة داخل التطبيق'
    );
  }
}

async function openInternalFileInfo(entry, errorMessage=''){
  const old = document.getElementById('qfsInternalViewer');
