async function chooseUserFilesDestination(title = 'اختيار مجلد الوجهة'){
  if(!state.userFilesRoot){
    throw new Error('اختر مجلد ملفاتك أولًا');
  }

  let current =
    state.userFilesCwd || state.userFilesRoot;

  const root = state.userFilesRoot;

  const renderDestination = async () => {

    const r = await call('list', {
      uri: current
    });

    const items = Array.isArray(r)
      ? r
      : (Array.isArray(r?.items) ? r.items : []);

    const folders =
      items.filter(x => x && x.dir && x.uri);

    const rows = folders.length
      ? folders.map((folder, index) => `
          <button
            type="button"
            class="user-files-destination-folder"
            data-dest-index="${index}"
            style="width:100%;text-align:start;margin:4px 0;">
            📁 ${esc(folder.name || 'مجلد')}
          </button>
        `).join('')
      : `
          <div style="padding:12px;opacity:.7">
            لا توجد مجلدات هنا.
          </div>
        `;

    modal(title, `
      <div class="modal-actions">

        <div style="width:100%;margin-bottom:8px">
          <strong>المجلد الحالي</strong>
          <div style="font-size:.8em;opacity:.7;word-break:break-all">
            ${esc(current)}
          </div>
        </div>

        <button
          id="ufDestSelect"
          class="primary"
          type="button">
          ✓ اختيار هذا المجلد
        </button>

        <button
          id="ufDestBack"
          type="button">
          ↩️ رجوع
        </button>

        <div
          style="width:100%;max-height:45vh;overflow:auto">
          ${rows}
        </div>

        <button
          id="ufDestCancel"
          type="button">
          إلغاء
        </button>

      </div>
    `);

    const select = $('#ufDestSelect');
    const back = $('#ufDestBack');
    const cancel = $('#ufDestCancel');

    if(select){
      select.onclick = () => {
        closeModal();
        window.__quickFileStudioDestination = current;
      };
    }

    if(back){
      back.onclick = async () => {

        if(current === root){
          toast('أنت داخل المجلد الرئيسي');
          return;
        }

        const parts = current.split('/');

        if(parts.length > 1){
          parts.pop();
          current = parts.join('/');
        }

        await renderDestination();
      };
    }

    if(cancel){
      cancel.onclick = () => {
        closeModal();
        window.__quickFileStudioDestination = null;
      };
    }

    document
      .querySelectorAll('[data-dest-index]')
      .forEach(btn => {

        btn.onclick = async () => {

          const index =
            Number(btn.dataset.destIndex);

          const folder = folders[index];

          if(!folder?.uri){
            return;
          }

          current = folder.uri;

          await renderDestination();
        };
      });
  };

  window.__quickFileStudioDestination = undefined;

  await renderDestination();

  return new Promise(resolve => {

    const timer = setInterval(() => {

      if(window.__quickFileStudioDestination !== undefined){

        clearInterval(timer);

        const result =
          window.__quickFileStudioDestination;

        window.__quickFileStudioDestination = undefined;

        resolve(result);
      }

    }, 50);

  });
}

