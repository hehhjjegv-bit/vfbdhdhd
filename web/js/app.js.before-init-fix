    position:fixed;
    inset:0;
    z-index:99999;
    background:#0b0b0b;
    color:#fff;
    display:flex;
    flex-direction:column;
  `;

  const size = entry.dir
    ? 'مجلد'
    : bytes(Number(entry.size || 0));

  overlay.innerHTML = `
    <div style="
      display:flex;
      align-items:center;
      gap:10px;
      padding:12px;
      background:#111;
      border-bottom:1px solid #333;
    ">
      <button id="qfsInfoBack" type="button">← رجوع</button>
      <strong style="flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">
        معلومات الملف
      </strong>
    </div>

    <div style="padding:24px;overflow:auto">
      <div style="font-size:56px;text-align:center;margin-bottom:20px">
        ${getUserFileIcon(entry.name || '', entry.mime || '')}
