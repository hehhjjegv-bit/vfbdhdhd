function getUserFileIcon(name, mime){
  const extension = ext(name);

  if(mime === 'application/pdf' || extension === 'pdf') return '📕';
  if(/^image\//i.test(mime)) return '🖼️';
  if(/^video\//i.test(mime)) return '🎬';
  if(/^audio\//i.test(mime)) return '🎵';

  if(['zip','rar','7z','tar','gz'].includes(extension)) return '🗜️';
  if(['apk','aab'].includes(extension)) return '📦';
  if(['js','ts','py','java','kt','c','cpp','h','hpp'].includes(extension)) return '💻';
  if(['html','css','xml','json'].includes(extension)) return '🌐';
