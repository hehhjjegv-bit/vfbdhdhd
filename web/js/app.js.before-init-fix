    }
  }
  else {try{await call('openExternal',{uri:e.uri,mime:e.mime||guessMime(e.name)});log('فتح خارجي',e.name)}catch(err){toast(err.message)}}
}
function isText(n){
  return /\.(txt|text|md|markdown|json|js|mjs|cjs|ts|tsx|jsx|css|scss|less|html|htm|xml|svg|py|pyw|java|kt|kts|c|cc|cpp|cxx|h|hh|hpp|cs|go|rs|php|rb|pl|lua|swift|dart|sh|bash|zsh|yml|yaml|toml|ini|cfg|conf|env|csv|tsv|sql|log|gradle|properties|gitignore|dockerfile)$/i.test(n || '');
}
function guessMime(n){const x=ext(n);return ({pdf:'application/pdf',png:'image/png',jpg:'image/jpeg',jpeg:'image/jpeg',webp:'image/webp',gif:'image/gif',mp4:'video/mp4',mp3:'audio/mpeg',html:'text/html',json:'application/json'})[x]||'application/octet-stream'}

async function openEditor(e){
  try{
    if(!e || !e.uri){
      throw new Error('مسار الملف غير صالح');
    }

    const r = await call('read', {uri:e.uri});

    let content = '';

    if(typeof r === 'string'){
      content = r;
    }else if(r && typeof r === 'object'){
      content =
        r.content ??
        r.text ??
        r.value ??
        '';
    }

    state.editorUri = e.uri;
    state.editorName = e.name || 'untitled.txt';
    state.editorDirty = false;
    state.editorCanWrite = e.canWrite !== false;

    const editor = document.getElementById('editor');

    if(!editor){
      throw new Error('المحرر غير موجود في الواجهة');
    }

    editor.value = String(content);

    const path = document.getElementById('editorPath');
    if(path){
      path.textContent = e.name || 'ملف';
    }

    const mode = document.getElementById('editorMode');
    if(mode && typeof detectLanguage === 'function'){
      try{
        mode.textContent = detectLanguage(e.name || '');
      }catch(_){}
    }

    if(window.qfsEditorCore){
      try{
        qfsEditorCore.updateStats();
      }catch(_){}

      try{
        qfsEditorCore.updateHighlight?.();
      }catch(_){}
    }

    if(typeof updateEditorStats === 'function'){
      try{ updateEditorStats(); }catch(_){}
    }

    editor.focus();

    log('فتح للتحرير', e.name || 'ملف');

    return true;

  }catch(err){
    console.error('[QFS] openEditor failed:', err);
    toast(err?.message || 'تعذر قراءة الملف');
    return false;
  }
}
